{
  "extends": [
    "next/core-web-vitals",
    "next/typescript"
  ],
  "rules": {
    "@typescript-eslint/no-unused-vars": [
      "warn",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_"
      }
    ],
    "@typescript-eslint/consistent-type-imports": [
      "warn",
      {
        "prefer": "type-imports",
        "fixStyle": "inline-type-imports"
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "src/features/audit/browser.ts",
        "src/features/reports/pdf.ts"
      ],
      "rules": {
        "@typescript-eslint/consistent-type-imports": "off"
      }
    }
  ]
}

# ---------------------------------------------------------------------------
# SitePilot AI — environment
# Copy to `.env.local` for development. Values are validated at boot by
# `src/lib/env.ts`; the app fails fast with a readable error if one is missing.
# ---------------------------------------------------------------------------

# Public site origin, used for OAuth redirects, emails and canonical URLs.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Database (Supabase Postgres) ------------------------------------------
# Pooled connection (PgBouncer) for the app, direct connection for migrations.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sitepilot?schema=public&pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/sitepilot?schema=public"

# --- Supabase Auth ----------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
# Server-only. Never expose. Used for admin operations (user sync, storage).
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# --- OpenAI -----------------------------------------------------------------
OPENAI_API_KEY="sk-..."
OPENAI_MODEL="gpt-4o"
OPENAI_MODEL_FAST="gpt-4o-mini"

# --- Google PageSpeed Insights ---------------------------------------------
# Optional. Without it PSI is rate-limited and the engine falls back to its
# own synthetic performance measurement.
GOOGLE_PAGESPEED_API_KEY=""

# --- Headless browser -------------------------------------------------------
# Path to a Chromium binary for screenshots + axe-core. Optional: when unset the
# engine degrades to static analysis and skips the browser-only checks.
CHROMIUM_EXECUTABLE_PATH=""

# --- Stripe -----------------------------------------------------------------
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_PRICE_PRO_MONTHLY="price_..."
STRIPE_PRICE_PRO_YEARLY="price_..."
STRIPE_PRICE_AGENCY_MONTHLY="price_..."
STRIPE_PRICE_AGENCY_YEARLY="price_..."

# --- Runtime ----------------------------------------------------------------
LOG_LEVEL="info"
